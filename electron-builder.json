{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.freecord.ptb",
  "productName": "Freecord",
  "artifactName": "${productName}-Setup-${version}.${ext}",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "publish": {
    "provider": "github",
    "owner": "Kauanmaffeikraus",
    "repo": "Freecord",
    "releaseType": "release"
  },
  "win": {
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/logo.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Freecord"
  },
  "linux": {
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "maintainer": "Kauanmaffeikraus <kauankrausmaffei@gmail.com>",
    "synopsis": "Serverless P2P Voice, Video & Chat",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/logo.png",
    "category": "Network;Chat;InstantMessaging"
  }
}
