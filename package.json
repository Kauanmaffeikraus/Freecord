{
  "name": "freecord-ptb",
  "version": "1.0.0",
  "description": "Freecord PTB — Serverless P2P Desktop & Web Communication reconstructed with REA evidence",
  "main": "electron/main.cjs",
  "author": "Kauanmaffeikraus",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kauanmaffeikraus/Freecord.git"
  },
  "scripts": {
    "dev:vite": "vite --port 5173",
